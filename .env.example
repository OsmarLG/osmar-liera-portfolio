# Measurement (all optional, all public). With no ID nothing loads and no cookie banner is shown.
# Set them in Netlify: Site configuration > Environment variables, then redeploy.

# Google Analytics 4 (G-XXXXXXXXXX). Loads with Consent Mode v2 (everything denied until the visitor accepts).
PUBLIC_GA4_ID=
# Google Tag Manager (GTM-XXXXXXX). Loads after the consent default is set.
PUBLIC_GTM_ID=
# Meta Pixel. Loads ONLY after the visitor accepts advertising cookies.
PUBLIC_META_PIXEL_ID=
# Google Search Console: renders <meta name="google-site-verification" content="...">.
PUBLIC_GOOGLE_SITE_VERIFICATION=
