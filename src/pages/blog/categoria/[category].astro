---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import BlogList from '../../../components/blog/BlogList.astro';
import { categoryPageCopy, getPosts, usedCategories } from '../../../lib/blog';

/** One page per category that has published posts. */
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return usedCategories(posts).map((category) => ({
    params: { category },
    props: { category, allPosts: posts, posts: posts.filter((post) => post.data.category === category) },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { category, allPosts, posts } = Astro.props as Props;
const copy = categoryPageCopy(category);
---

<BlogList posts={posts} allPosts={allPosts} category={category} title={copy.title} heading={copy.heading} description={copy.description} intro={copy.intro} />
