---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Dictionary } from '../i18n';
import { SITE_URL, person } from '../i18n/profile';
import { socialProfiles } from '../i18n/social';

interface Props {
  dict: Dictionary;
  title: string;
  description: string;
  /** Path of this page, e.g. "/" or "/en/cv/". */
  path: string;
  /** Path of the same page in the other language. */
  altPath?: string;
  noindex?: boolean;
  structuredData?: object;
  ogType?: 'website' | 'profile';
  /** Whether to load the scroll/motion layer (GSAP + Lenis). */
  motion?: boolean;
}

const { dict, title, description, path, altPath, noindex = false, structuredData, ogType = 'website', motion = true } = Astro.props;

const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL(dict.meta.ogImage, SITE_URL).href;
const esPath = dict.lang === 'es' ? path : altPath;
const enPath = dict.lang === 'en' ? path : altPath;
---

<!doctype html>
<html lang={dict.htmlLang} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {
      !noindex && esPath && enPath && (
        <>
          <link rel="alternate" hreflang="es-MX" href={new URL(esPath, SITE_URL).href} />
          <link rel="alternate" hreflang="en" href={new URL(enPath, SITE_URL).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(esPath, SITE_URL).href} />
        </>
      )
    }
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <meta name="author" content={person.fullName} />
    <meta name="theme-color" content="#05090d" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {socialProfiles.map((profile) => <link rel="me" href={profile.href} />)}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Osmar Liera" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={dict.ogLocale} />
    <meta property="og:locale:alternate" content={dict.ogLocaleAlternate} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dict.meta.ogAlt} />
    {
      ogType === 'profile' && (
        <>
          <meta property="profile:first_name" content="Osmar" />
          <meta property="profile:last_name" content="Liera" />
          <meta property="profile:username" content="OsmarLG" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={dict.meta.ogAlt} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body data-motion={motion ? 'on' : 'off'}>
    <a class="skip-link" href="#contenido">{dict.ui.skip}</a>
    <Header dict={dict} altPath={altPath ?? dict.altPaths.home} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer dict={dict} altPath={altPath ?? dict.altPaths.home} />
    <slot name="after" />

    <script>
      import { initSite } from '../scripts/site';

      initSite();

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion && document.body.dataset.motion === 'on') {
        // The motion layer is an enhancement: load it once the page is idle.
        const loadMotion = (): void => {
          import('../scripts/motion').then(({ initMotion }) => initMotion());
        };
        const whenIdle = (): void => {
          if ('requestIdleCallback' in window) {
            window.requestIdleCallback(loadMotion, { timeout: 2500 });
          } else {
            setTimeout(loadMotion, 400);
          }
        };
        if (document.readyState === 'complete') {
          whenIdle();
        } else {
          window.addEventListener('load', whenIdle, { once: true });
        }
      }
    </script>
  </body>
</html>
