---
import VideoReel from './VideoReel.astro';
import { showcaseImage } from '../../lib/showcase';
import type { ShowcasePiece } from '../../i18n/types';

interface Props {
  media: ShowcasePiece;
  playLabel: string;
  pauseLabel: string;
}

const { media, playLabel, pauseLabel } = Astro.props;
const image = media.kind === 'image' ? showcaseImage(media.piece) : null;
---

{/* One real piece in a box of its own aspect ratio: a lazy image or a VideoReel. */}
{
  image ? (
    <div class="piece" style={`aspect-ratio: ${image.width} / ${image.height}`}>
      <img src={image.src} alt={media.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
    </div>
  ) : (
    <VideoReel piece={media.piece} label={media.alt} playLabel={playLabel} pauseLabel={pauseLabel} />
  )
}

<style>
  .piece {
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .piece img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
