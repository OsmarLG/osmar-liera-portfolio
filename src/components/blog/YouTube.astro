---
/**
 * <YouTube id title start? /> — lite embed: only the thumbnail and a play button load;
 * the youtube-nocookie iframe is created after the click.
 */
interface Props {
  id: string;
  title: string;
  /** Start time in seconds. */
  start?: number;
}

const { id, title, start } = Astro.props;
const videoId = encodeURIComponent(id);
const startAt = start ? Math.floor(start) : 0;
const params = new URLSearchParams({ autoplay: '1', rel: '0' });
if (startAt) {
  params.set('start', String(startAt));
}
const embed = `https://www.youtube-nocookie.com/embed/${videoId}?${params.toString()}`;
const watch = `https://www.youtube.com/watch?v=${videoId}${startAt ? `&t=${startAt}s` : ''}`;
const thumb = `https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`;
---

<figure class="yt">
  <div class="yt__frame" data-yt data-yt-embed={embed} data-yt-title={title}>
    <a class="yt__play" href={watch} target="_blank" rel="noopener noreferrer" data-yt-play>
      <img src={thumb} alt="" width="480" height="360" loading="lazy" decoding="async" />
      <span class="yt__button" aria-hidden="true">
        <svg viewBox="0 0 68 48" width="68" height="48">
          <path
            d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3Z"
            fill="currentColor"></path>
          <path d="m27 34 18-10-18-10v20Z" fill="#fff"></path>
        </svg>
      </span>
      <span class="sr-only">Reproducir el video: {title}</span>
    </a>
  </div>
  <figcaption class="yt__caption">{title}</figcaption>
</figure>

<script>
  document.addEventListener('click', (event) => {
    const play = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-yt-play]');
    if (!play || event.metaKey || event.ctrlKey || event.shiftKey) {
      return;
    }
    const frame = play.closest<HTMLElement>('[data-yt]');
    if (!frame) {
      return;
    }
    event.preventDefault();
    const iframe = document.createElement('iframe');
    iframe.src = frame.dataset.ytEmbed ?? '';
    iframe.title = frame.dataset.ytTitle ?? '';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    frame.replaceChildren(iframe);
    iframe.focus();
  });
</script>

<style>
  .yt {
    margin-block: 2rem;
  }

  .yt__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #000;
  }

  .yt__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .yt__play img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt__button {
    position: relative;
    color: rgb(33 33 33 / 0.85);
    transition: color 0.2s ease;
  }

  .yt__play:hover .yt__button,
  .yt__play:focus-visible .yt__button {
    color: #f00;
  }

  .yt__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt__caption {
    margin-top: 0.6rem;
    color: var(--text-3);
    font-size: 0.9rem;
  }
</style>
