---
import { categoryLabels, categoryPath, formatDate, isoDate, postPath, readingMinutes, type Post } from '../../lib/blog';

interface Props {
  post: Post;
  /** Heading level of the card title. */
  headingLevel?: 'h2' | 'h3';
  /** The first card of a list can load its cover eagerly. */
  eager?: boolean;
  /** Name for view transitions (blog list filter), unique per page. */
  transitionName?: string;
}

const { post, headingLevel: Heading = 'h3', eager = false, transitionName } = Astro.props;
const { title, description, category, date, cover, draft } = post.data;
const minutes = readingMinutes(post.body);
---

<article class="post-card" data-tilt="7" style={transitionName ? `view-transition-name: ${transitionName}` : undefined}>
  <div class="post-card__media">
    <img
      src={cover}
      alt=""
      width="1600"
      height="900"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>
  <div class="post-card__body">
    <p class="post-card__meta mono">
      <a href={categoryPath(category)}>{categoryLabels[category]}</a>
      <span aria-hidden="true">·</span>
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min</span>
      {draft && <span class="post-card__draft">borrador</span>}
    </p>
    <Heading class="post-card__title">
      <a href={postPath(post)}>{title}</a>
    </Heading>
    <p class="post-card__text">{description}</p>
  </div>
</article>

<script>
  import { initTilt } from '../../scripts/tilt';

  initTilt();
</script>

<style>
  .post-card {
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    transform: perspective(900px) rotateX(var(--rx)) rotateY(var(--ry));
    transition:
      border-color 0.25s ease,
      box-shadow 0.4s ease,
      transform 0.7s var(--ease-out);
  }

  .post-card:hover {
    border-color: var(--line-strong);
  }

  /* Tilt (fine pointers, see scripts/tilt.ts) and a spotlight that follows the pointer. */
  .post-card.is-tilting {
    border-color: rgb(95 224 245 / 0.35);
    box-shadow: 0 30px 60px -35px rgb(0 0 0 / 0.9);
    transition:
      border-color 0.25s ease,
      box-shadow 0.4s ease,
      transform 0.12s linear;
  }

  .post-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(380px circle at var(--mx, 50%) var(--my, 0%), rgb(95 224 245 / 0.13), transparent 50%);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .post-card.is-tilting::before {
    opacity: 1;
  }

  .post-card__media {
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    background: var(--surface-2);
  }

  .post-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .post-card:hover .post-card__media img {
    transform: scale(1.03);
  }

  .post-card__body {
    display: grid;
    gap: 0.55rem;
    padding: 1.1rem 1.25rem 1.35rem;
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    color: var(--text-3);
    font-size: 0.76rem;
  }

  .post-card__meta a {
    position: relative;
    z-index: 2;
    color: var(--accent);
    text-decoration: none;
  }

  .post-card__meta a:hover {
    text-decoration: underline;
  }

  .post-card__draft {
    padding: 0 0.4rem;
    border-radius: 4px;
    background: var(--amber-soft);
    color: var(--amber);
  }

  .post-card__title {
    font-size: 1.35rem;
    line-height: 1.15;
  }

  .post-card__title a {
    color: var(--text);
    text-decoration: none;
  }

  /* The whole card is clickable through the title link. */
  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .post-card__title a:hover {
    color: var(--accent);
  }

  .post-card__text {
    color: var(--text-2);
    font-size: 0.97rem;
    line-height: 1.55;
  }
</style>
