---
import type { Dictionary } from '../../i18n';
import type { StepKey } from '../../i18n/types';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const steps: StepKey[] = ['request', 'agent', 'tools', 'approval', 'result'];
---

<div class="trace-rail" aria-hidden="true" data-trace>
  <div class="trace-rail__track">
    <span class="trace-rail__progress" data-trace-progress></span>
  </div>
  <ol class="trace-rail__steps">
    {
      steps.map((step, index) => (
        <li class="trace-rail__step" data-trace-step={step} data-state={index === 0 ? 'active' : 'idle'}>
          <span class="trace-rail__dot" />
          <span class="trace-rail__label">
            <span class="trace-rail__num">0{index}</span>
            {dict.ui.steps[step]}
          </span>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .trace-rail {
    display: none;
  }

  @media (min-width: 1400px) {
    .trace-rail {
      position: fixed;
      left: max(16px, calc((100vw - var(--max)) / 2 - 150px));
      top: 50%;
      z-index: 20;
      display: block;
      height: min(56vh, 460px);
      transform: translateY(-50%);
      pointer-events: none;
    }
  }

  .trace-rail__track {
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 1px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .trace-rail__progress {
    position: absolute;
    inset: 0;
    background: linear-gradient(var(--accent), var(--accent-strong));
    transform: scaleY(0);
    transform-origin: top center;
  }

  .trace-rail__steps {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    list-style: none;
    padding: 0;
  }

  .trace-rail__step {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .trace-rail__dot {
    width: 11px;
    height: 11px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--bg);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .trace-rail__label {
    display: none;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-3);
    transition: color 0.3s ease;
  }

  @media (min-width: 1580px) {
    .trace-rail__label {
      display: flex;
    }
  }

  .trace-rail__num {
    opacity: 0.8;
  }

  .trace-rail__step[data-state='done'] .trace-rail__dot {
    border-color: var(--accent-strong);
    background: var(--accent-strong);
  }

  .trace-rail__step[data-state='active'] .trace-rail__dot {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 5px var(--accent-soft);
  }

  .trace-rail__step[data-state='active'] .trace-rail__label {
    color: var(--accent);
  }

  .trace-rail__step[data-trace-step='approval'][data-state='active'] .trace-rail__dot {
    border-color: var(--amber);
    background: var(--amber);
    box-shadow: 0 0 0 5px var(--amber-soft);
  }

  .trace-rail__step[data-trace-step='approval'][data-state='active'] .trace-rail__label {
    color: var(--amber);
  }
</style>
