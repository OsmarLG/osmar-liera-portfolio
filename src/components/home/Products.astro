---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';
import type { Dictionary } from '../../i18n';
import type { ProjectImageKey } from '../../i18n/types';
import pmcrmDashboard from '../../assets/projects/pmcrm-dashboard.png';
import avtMap from '../../assets/projects/avt-map.png';
import avtSatellite from '../../assets/projects/avt-satellite.png';
import nopalgreenLanding from '../../assets/projects/nopalgreen-landing.png';
import nopalgreenPos from '../../assets/projects/nopalgreen-pos.png';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const { products, ui } = dict;

const sources: Record<ProjectImageKey, ImageMetadata> = {
  'pmcrm-dashboard': pmcrmDashboard,
  'avt-map': avtMap,
  'avt-satellite': avtSatellite,
  'nopalgreen-landing': nopalgreenLanding,
  'nopalgreen-pos': nopalgreenPos,
};

/** Full-size WebP used by the screenshot dialog (and as the no-JS link target). */
const fullSize = Object.fromEntries(
  await Promise.all(
    Object.entries(sources).map(async ([key, src]) => [key, await getImage({ src, format: 'webp', quality: 82 })] as const),
  ),
) as Record<ProjectImageKey, Awaited<ReturnType<typeof getImage>>>;
---

<section class="section products" id={dict.ids.products} data-step="result" aria-labelledby="products-title">
  <div class="container">
    <header class="section-head">
      <h2 class="section-title" id="products-title" data-split-title>{products.title}</h2>
      <p class="section-intro" data-reveal>{products.intro}</p>
    </header>

    <ol class="product-list" role="list">
      {
        products.items.map((product, index) => (
          <li class="product" data-reveal>
            <article aria-labelledby={`product-${index}`}>
              <div class="product__grid">
                <div class="product__copy">
                  <p class="product__tagline mono">
                    <span aria-hidden="true">{String(index + 1).padStart(2, '0')} · </span>
                    {product.tagline}
                  </p>
                  <h3 class="product__name" id={`product-${index}`}>
                    {product.name}
                  </h3>
                  <p class="product__summary">{product.summary}</p>
                  <ul class="product__features" role="list">
                    {product.features.map((feature) => (
                      <li>
                        <Icon name="check" size={16} />
                        {feature}
                      </li>
                    ))}
                  </ul>
                  <p class="product__stack-note mono">{product.stackNote}</p>
                  <ul class="product__stack" role="list">
                    {product.stack.map((tech) => (
                      <li class="chip">{tech}</li>
                    ))}
                  </ul>
                  <a class="btn btn--small product__repo" href={product.repo} target="_blank" rel="noopener noreferrer">
                    <Icon name="github" size={16} />
                    {ui.viewRepo}
                    <span class="product__repo-name mono">{product.repoLabel}</span>
                    <span class="sr-only">{ui.newTab}</span>
                  </a>
                </div>

                <div class:list={['product__shots', { 'product__shots--pair': product.images.length > 1 }]}>
                  {product.images.map((image, imageIndex) => {
                    const full = fullSize[image.key];
                    return (
                      <figure class="shot">
                        <a
                          class="shot__link"
                          href={full.src}
                          data-lightbox-trigger
                          data-alt={image.alt}
                          data-width={full.attributes.width}
                          data-height={full.attributes.height}
                        >
                          <span class="shot__chrome" aria-hidden="true">
                            <i />
                            <i />
                            <i />
                          </span>
                          <Picture
                            src={sources[image.key]}
                            formats={['avif', 'webp']}
                            fallbackFormat="webp"
                            widths={imageIndex === 0 ? [480, 800, 1200] : [400, 640]}
                            sizes={
                              imageIndex === 0
                                ? '(min-width: 1000px) 640px, 92vw'
                                : '(min-width: 1000px) 320px, 46vw'
                            }
                            alt={image.alt}
                            loading="lazy"
                            decoding="async"
                            class="shot__img"
                          />
                          <span class="shot__hint">
                            <Icon name="expand" size={14} />
                            {ui.enlarge}
                          </span>
                        </a>
                        <figcaption class="shot__label mono">{image.label}</figcaption>
                      </figure>
                    );
                  })}
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<dialog class="lightbox" data-lightbox aria-label={ui.imageDialog}>
  <div class="lightbox__inner">
    <button class="lightbox__close" type="button" data-lightbox-close>
      <Icon name="close" size={20} />
      <span>{ui.close}</span>
    </button>
    <div class="lightbox__frame" data-lightbox-frame></div>
    <p class="lightbox__caption" data-lightbox-caption aria-hidden="true"></p>
  </div>
</dialog>

<style>
  .product-list {
    display: grid;
    gap: clamp(3.5rem, 8vw, 6rem);
    list-style: none;
    padding: 0;
  }

  .product__grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 1000px) {
    .product__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }

    .product:nth-child(even) .product__copy {
      order: 2;
    }
  }

  .product__tagline {
    color: var(--accent);
    font-size: 0.8rem;
  }

  .product__name {
    margin-top: 0.5rem;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .product__summary {
    margin-top: 1rem;
    color: var(--text-2);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .product__features {
    display: grid;
    gap: 0.45rem;
    margin-top: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .product__features li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .product__features :global(svg) {
    color: var(--accent);
  }

  .product__stack-note {
    margin-top: 1.5rem;
    color: var(--text-3);
    font-size: 0.75rem;
  }

  .product__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .product__repo {
    margin-top: 1.5rem;
  }

  .product__repo-name {
    color: var(--text-3);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .product__shots {
    display: grid;
    gap: 1rem;
  }

  .product__shots--pair {
    display: block;
    position: relative;
    padding-bottom: 16%;
  }

  .product__shots--pair .shot:first-child {
    width: 86%;
  }

  .product__shots--pair .shot:nth-child(2) {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: 52%;
  }

  .product__shots--pair .shot:nth-child(2) .shot__link {
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.9);
  }

  .shot__link {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .shot__chrome {
    display: flex;
    gap: 5px;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--line);
    background: var(--bg-elev);
  }

  .shot__chrome i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .shot__link :global(.shot__img) {
    width: 100%;
    transition: transform 0.7s var(--ease-out);
  }

  .shot__link:hover :global(.shot__img) {
    transform: scale(1.025);
  }

  .shot__hint {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    background: rgb(5 9 13 / 0.88);
    color: var(--text);
    font-size: 0.78rem;
    font-weight: 600;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.25s ease,
      transform 0.3s var(--ease-out);
  }

  .shot__link:hover .shot__hint,
  .shot__link:focus-visible .shot__hint {
    opacity: 1;
    transform: none;
  }

  @media (hover: none) {
    .shot__hint {
      opacity: 1;
      transform: none;
    }
  }

  .shot__label {
    margin-top: 0.5rem;
    color: var(--text-3);
    font-size: 0.75rem;
  }

  /* Dialog --------------------------------------------------------- */
  .lightbox {
    width: min(1400px, 100% - 2rem);
    max-width: none;
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-l);
    background: var(--bg-elev);
    color: var(--text);
  }

  .lightbox::backdrop {
    background: rgb(2 5 8 / 0.88);
  }

  .lightbox__inner {
    display: grid;
    gap: 0.75rem;
    padding: 0.75rem;
  }

  .lightbox__close {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0.4rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    font-weight: 600;
  }

  .lightbox__close:hover {
    border-color: var(--accent);
  }

  .lightbox__frame :global(img) {
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 9rem);
    object-fit: contain;
    border-radius: var(--radius-s);
  }

  .lightbox__caption {
    color: var(--text-2);
    font-size: 0.9rem;
    padding: 0 0.25rem 0.25rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] {
      animation: lightbox-in 0.35s var(--ease-out);
    }
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }
</style>
