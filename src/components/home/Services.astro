---
import Icon from '../Icon.astro';
import Kicker from '../Kicker.astro';
import ServiceCard from '../showcase/ServiceCard.astro';
import type { Dictionary } from '../../i18n';
import { whatsappHref } from '../../i18n/profile';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const services = dict.services;
---

{
  services && (
    <section class="section services" id={dict.ids.services} data-step="agent" data-cloud-shape="cursor" aria-labelledby="services-title">
      <div class="container">
        <div class="section-head">
          <span class="cloud-target" data-cloud-target aria-hidden="true"></span>
          <Kicker text={services.kicker} />
          <h2 class="section-title" id="services-title" data-split-title>
            {services.title}
          </h2>
          <p class="section-intro" data-reveal>
            {services.intro}
          </p>
        </div>

        {/* Each implementation with one real piece. A scroll-snap row on small screens, five columns on wide ones. */}
        <div class="services__scroller" role="group" aria-label={services.implementations.name} tabindex="0">
          <ul class="services__cards" role="list" data-reveal-group>
            {services.cards.map((card) => (
              <ServiceCard card={card} playLabel={dict.ui.playVideo} pauseLabel={dict.ui.pauseVideo} />
            ))}
          </ul>
        </div>

        <div class="services__path" data-reveal>
          <div class="services__stage services__stage--entry">
            <h3 class="services__stage-name">{services.diagnostic.name}</h3>
            <p class="services__stage-text">{services.diagnostic.text}</p>
            <a
              class="btn btn--primary services__cta"
              href={whatsappHref(services.diagnostic.whatsappMessage)}
              target="_blank"
              rel="noopener noreferrer"
              data-wa
              data-wa-message={services.diagnostic.whatsappMessage}
              data-wa-location={`${dict.ids.services}-diagnostico`}
            >
              <Icon name="whatsapp" size={18} />
              {services.diagnostic.cta}
              <span class="sr-only">{dict.ui.newTab}</span>
            </a>
          </div>
          <div class="services__stage">
            <h3 class="services__stage-name">{services.monthly.name}</h3>
            <p class="services__stage-text">{services.monthly.text}</p>
            <p class="services__stage-note">{services.monthly.note}</p>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  /* Small screens: a row that scrolls sideways and bleeds to the screen edges. */
  .services__scroller {
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }

  .services__scroller::-webkit-scrollbar {
    display: none;
  }

  .services__scroller:focus-visible {
    outline-offset: -2px;
  }

  .services__cards {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: clamp(180px, 62vw, 240px);
    gap: clamp(0.75rem, 1.6vw, 1rem);
    width: max-content;
    padding-block: 4px;
  }

  .services__cards > :global(*) {
    scroll-snap-align: center;
  }

  @media (min-width: 1000px) {
    .services__scroller {
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }

    .services__cards {
      grid-auto-flow: row;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      width: auto;
    }
  }

  .services__path {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  @media (min-width: 800px) {
    .services__path {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }

  .services__stage {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius-l);
    background: var(--surface);
  }

  .services__stage--entry {
    background: var(--surface-2);
  }

  .services__stage-name {
    font-size: var(--step-2);
  }

  .services__stage-text {
    max-width: 52ch;
    color: var(--text-2);
  }

  .services__stage-note {
    color: var(--text-3);
    font-size: 0.92rem;
  }

  .services__cta {
    margin-top: 0.6rem;
  }
</style>
