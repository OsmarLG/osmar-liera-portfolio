---
import Icon from '../Icon.astro';
import Kicker from '../Kicker.astro';
import type { Dictionary } from '../../i18n';
import { whatsappHref } from '../../i18n/profile';

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
const services = dict.services;
---

{
  services && (
    <section class="section services" id={dict.ids.services} data-step="agent" data-cloud-shape="cursor" aria-labelledby="services-title">
      <div class="container">
        <div class="section-head">
          <span class="cloud-target" data-cloud-target aria-hidden="true"></span>
          <Kicker text={services.kicker} />
          <h2 class="section-title" id="services-title" data-split-title>
            {services.title}
          </h2>
          <p class="section-intro" data-reveal>
            {services.intro}
          </p>
        </div>

        <ol class="services__grid" role="list" data-reveal-group>
          <li class="service service--entry">
            <p class="service__label mono">{services.diagnostic.label}</p>
            <h3 class="service__name">{services.diagnostic.name}</h3>
            <p class="service__text">{services.diagnostic.text}</p>
            <ul class="service__bullets" role="list">
              {services.diagnostic.bullets.map((bullet) => (
                <li>
                  <Icon name="check" size={16} />
                  {bullet}
                </li>
              ))}
            </ul>
            <a
              class="btn btn--primary service__cta"
              href={whatsappHref(services.diagnostic.whatsappMessage)}
              target="_blank"
              rel="noopener noreferrer"
              data-wa
              data-wa-message={services.diagnostic.whatsappMessage}
              data-wa-location={`${dict.ids.services}-diagnostico`}
            >
              <Icon name="whatsapp" size={18} />
              {services.diagnostic.cta}
              <span class="sr-only">{dict.ui.newTab}</span>
            </a>
          </li>

          <li class="service">
            <p class="service__label mono">{services.implementations.label}</p>
            <h3 class="service__name">{services.implementations.name}</h3>
            <p class="service__text">{services.implementations.text}</p>
            <dl class="service__items">
              {services.implementations.items.map((item) => (
                <div>
                  <dt>{item.name}</dt>
                  <dd>{item.text}</dd>
                </div>
              ))}
            </dl>
          </li>

          <li class="service">
            <p class="service__label mono">{services.monthly.label}</p>
            <h3 class="service__name">{services.monthly.name}</h3>
            <p class="service__text">{services.monthly.text}</p>
            <ul class="service__bullets" role="list">
              {services.monthly.bullets.map((bullet) => (
                <li>
                  <Icon name="check" size={16} />
                  {bullet}
                </li>
              ))}
            </ul>
            <p class="service__note">{services.monthly.note}</p>
          </li>
        </ol>

        <div class="services__foot" data-reveal>
          <p class="services__audience">{services.audience}</p>
          <a
            class="btn"
            href={whatsappHref(services.whatsappMessage)}
            target="_blank"
            rel="noopener noreferrer"
            data-wa
            data-wa-message={services.whatsappMessage}
            data-wa-location={dict.ids.services}
          >
            <Icon name="whatsapp" size={18} />
            {services.cta}
            <span class="sr-only">{dict.ui.newTab}</span>
          </a>
        </div>
      </div>
    </section>
  )
}

<style>
  .services__grid {
    display: grid;
    gap: 1rem;
    counter-reset: none;
  }

  @media (min-width: 1000px) {
    .services__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr) minmax(0, 1fr);
      align-items: stretch;
    }
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
  }

  .service--entry {
    border-color: rgb(95 224 245 / 0.35);
    background: linear-gradient(150deg, rgb(95 224 245 / 0.1), var(--surface) 60%);
  }

  .service__label {
    color: var(--accent);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .service__name {
    font-size: var(--step-2);
  }

  .service__text {
    color: var(--text-2);
  }

  .service__bullets {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.4rem;
  }

  .service__bullets li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 0.6rem;
    align-items: start;
    color: var(--text-2);
    font-size: 0.97rem;
    line-height: 1.5;
  }

  .service__bullets :global(svg) {
    margin-top: 0.25rem;
    color: var(--green);
  }

  .service__items {
    display: grid;
    gap: 0.9rem;
    margin-top: 0.4rem;
  }

  .service__items div {
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .service__items dt {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 1.1rem;
  }

  .service__items dd {
    margin-top: 0.15rem;
    color: var(--text-2);
    font-size: 0.97rem;
    line-height: 1.5;
  }

  .service__note {
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--text-3);
    font-size: 0.92rem;
  }

  .service__cta {
    align-self: flex-start;
    margin-top: auto;
  }

  .service--entry .service__bullets {
    margin-bottom: 1rem;
  }

  .services__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: clamp(2rem, 5vw, 3rem);
  }

  .services__audience {
    max-width: 62ch;
    color: var(--text-2);
  }
</style>
